# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# SwiftPM
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/

# Who is signing this build, and the app group that follows from it. Whoever is not upstream needs
# their own team and their own group domain, and neither is ever theirs to commit -- see
# Xcode-config/Shared.xcconfig, which builds as upstream when this file is absent.
Xcode-config/Local.xcconfig

# macOS
.DS_Store

# Never commit the ROM, or anything derived from it. The engine reads a SCCore.dll the user
# supplies from their own licensed SOUND Canvas VA install; nothing Roland-derived belongs here.
*.dll
*.wav

# Duplicate of the icon source inside the app folder.
/ts.icon/
