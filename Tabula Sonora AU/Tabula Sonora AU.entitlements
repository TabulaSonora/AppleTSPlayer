<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The same group the app is entitled to, in its iOS spelling. Without this the extension sees
	  only its own container and there is no ROM in it -- see the macOS file beside this one.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TS_APP_GROUP)</string>
	</array>
</dict>
</plist>
