<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The team-prefixed spelling macOS requires, matching the app's own macOS entitlements. This is
	  the whole reason the plugin can read the ROM: an Audio Unit extension is sandboxed into its own
	  container, and an app group is the one place two bundles signed by the same team may share.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.co.losno.tabula-sonora</string>
	</array>
</dict>
</plist>
