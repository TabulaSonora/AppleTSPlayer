        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "エンジンがボイスを奪い始めるまでのボイス数"
          }
        }
      }
    },
    "Voices sounding, of the polyphony the engine was built with": {
      "comment": "A label that shows the number of voices and the capacity of the engine.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voces sonando, de la polifonía con que se construyó el motor"
