    "Open Tabula Sonora Player and import SCCore.dll there. This plugin reads it from the same place.": {
      "comment": "A description of how to find the ROM.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tabula Sonora Player e importa ahí SCCore.dll. Este plugin la lee del mismo lugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabula Sonora Playerを開いてSCCore.dllを読み込んでください。このプラグインは同じ場所から読み込みます。"
          }
        }
      }
    },
