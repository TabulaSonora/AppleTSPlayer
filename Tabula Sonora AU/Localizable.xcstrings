        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発音中のボイス数（エンジンのポリフォニー数に対する）"
          }
        }
      }
    },
    "Which module's tone map program changes resolve against": {
      "comment": "A label for the module a voice uses to resolve against.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "El módulo con cuyo mapa de tonos se resuelven los cambios de programa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "どのモジュールの音色マップでプログラムチェンジを解決するか"
          }
        }
      }
    },
    "XG · %lld/%lld": {
      "comment": "A label that shows the number of voices and the capacity of the engine. The first argument is the number of voices. The second argument is the capacity of the engine.",
