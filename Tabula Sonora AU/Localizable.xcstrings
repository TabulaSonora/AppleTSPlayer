    "The hardware has two ports. More is an extension, for files that want it.": {
      "comment": "A description of the number of ports the hardware has.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "El hardware tiene dos puertos. Más es una extensión, para los archivos que la pidan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ハードウェアのポートは2つです。それより多い設定は、それを必要とするファイルのための拡張です。"
          }
        }
      }
    },
    "Voice": {
      "comment": "The name of the parameter group that controls the voice settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Voz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ボイス"
          }
        }
      }
    },
    "Voices before the engine starts stealing them": {
      "comment": "A label for the number of voices the engine can play at once.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-CL": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Voces antes de que el motor empiece a robarlas"
