<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The same group as the iOS file beside this one, spelled the way macOS demands: an app group
	  identifier has to begin with the team identifier there, and with "group." on iOS, and neither
	  platform accepts the other's spelling. One target builds for both, so the entitlements file is
	  chosen per SDK -- see CODE_SIGN_ENTITLEMENTS[sdk=macosx*].

	  The domain comes from TS_APP_GROUP_DOMAIN in Xcode-config/Shared.xcconfig, because a group has
	  to be registered to the team that signs it and a fork under another team needs its own. This
	  is the only place the identifier is written: ROMStore reads it back out of the running
	  process's entitlements rather than keeping a copy that could disagree with this one.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.$(TS_APP_GROUP_DOMAIN).tabula-sonora</string>
	</array>
</dict>
</plist>
